# DRK submission form — server-side config.
# Copy to .env.local for `vercel dev`, and set the same keys in
# Vercel -> Project -> Settings -> Environment Variables for production.
# .env.local is gitignored and is NOT deployed.

# --- required -------------------------------------------------------------

# Resend API key. Use a Sending-access key restricted to drkgroup.xyz,
# not a Full-access one. RESEND_API is accepted as an alias.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# --- email routing (all optional; these are the defaults) -----------------

# Comma-separated. Verifying a domain for sending does NOT create an inbox at
# that address, so nick@ is included to guarantee submissions land somewhere
# read. Drop it once contact@ receives mail on its own.
SUBMISSIONS_TO=contact@drkgroup.xyz,nick@drkgroup.xyz

# Must be an address on a domain verified in Resend.
MAIL_FROM=DRK <contact@drkgroup.xyz>

# Reply-To on the applicant's receipt — where their replies actually go.
REPLY_TO=nick@drkgroup.xyz

# Where applicants are sent once the form is submitted.
REDIRECT_URL=https://drkgroup.xyz

# --- telegram (all optional) ----------------------------------------------

# Invite link shown on the confirmation screen and in the receipt email.
# Create the group, then: group -> Manage -> Invite Links -> create a link.
# Leave blank and the Telegram card simply does not render.
TELEGRAM_INVITE_LINK=

# Posts a short alert to an existing DRK ops chat on each submission.
# BOT_FATHER is accepted as an alias for the token.
TELEGRAM_BOT_TOKEN=
# Numeric chat id, e.g. -1001234567890. Add the bot to the group first,
# then read the id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=
